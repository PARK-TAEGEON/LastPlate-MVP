{
  "$defs": {
    "AnalysisScope": {
      "additionalProperties": false,
      "properties": {
        "target_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Date"
        },
        "meal_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Meal Type"
        },
        "menus": {
          "items": {
            "$ref": "#/$defs/MenuScope"
          },
          "title": "Menus",
          "type": "array"
        },
        "menus_complete": {
          "default": false,
          "title": "Menus Complete",
          "type": "boolean"
        },
        "coverage": {
          "default": "unknown",
          "enum": [
            "full",
            "event",
            "unknown"
          ],
          "title": "Coverage",
          "type": "string"
        }
      },
      "title": "AnalysisScope",
      "type": "object"
    },
    "MenuScope": {
      "additionalProperties": false,
      "properties": {
        "menu": {
          "minLength": 1,
          "title": "Menu",
          "type": "string"
        },
        "ingredients": {
          "items": {
            "type": "string"
          },
          "title": "Ingredients",
          "type": "array"
        },
        "ingredients_complete": {
          "default": false,
          "title": "Ingredients Complete",
          "type": "boolean"
        }
      },
      "required": [
        "menu"
      ],
      "title": "MenuScope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "dependency_basis": {
      "default": "independent",
      "enum": [
        "independent",
        "demand_scaled"
      ],
      "title": "Dependency Basis",
      "type": "string"
    },
    "target_date": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Date"
    },
    "prediction_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prediction Id"
    },
    "input_revision": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input Revision"
    },
    "result_revision": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result Revision"
    },
    "analysis_scope": {
      "$ref": "#/$defs/AnalysisScope"
    },
    "consumed_results": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Consumed Results",
      "type": "object"
    },
    "metadata_source": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Metadata Source"
    }
  },
  "title": "Provenance",
  "type": "object"
}