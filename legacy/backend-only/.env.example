# Optional: supply through PowerShell environment or uvicorn --env-file (python-dotenv separately required).
# Without an agent URL, the preserved local Operation API still runs.
LASTPLATE_AGENT_BASE_URL=http://127.0.0.1:8001
LASTPLATE_AGENT_TIMEOUT_SECONDS=600
LASTPLATE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
